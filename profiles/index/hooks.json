{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/guard-new-packages.sh",
            "timeout": 5,
            "statusMessage": "Checking for unrequested package installs..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/auto-lint-fix.sh",
            "timeout": 30,
            "statusMessage": "Running lint --fix..."
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/prisma-auto-flow.sh",
            "timeout": 60,
            "statusMessage": "Checking Prisma schema sync..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/stop-gate.sh",
            "timeout": 10,
            "statusMessage": "Pre-ship gate..."
          }
        ]
      }
    ]
  }
}
