  "captions": [
    {
      "element": ".cap-t0",
      "text": "Kiến trúc hệ thống AI Agents without Jev vs with Jev",
      "window": [
        0.0,
        2.8736
      ]
    },
    {
      "element": ".cap-b1",
      "text": "Một ticket vào: giao cho agent nào? Chưa có Jev, câu này phải hỏi LLM.",
      "window": [
        4.3103,
        8.6207
      ]
    },
    {
      "element": ".cap-b2",
      "text": "Code chỉ cần một chữ sales, nhưng LLM vẫn phải sinh từng token.",
      "window": [
        11.2069,
        15.5172
      ]
    },
    {
      "element": ".cap-b3",
      "text": "Agent chạy nhiều bước: những lần chờ nhỏ ở mỗi lựa chọn cứ thế cộng dồn.",
      "window": [
        18.1034,
        22.4138
      ]
    },
    {
      "element": ".cap-b4",
      "text": "Giả sử 50K ticket mỗi ngày: giờ cao điểm LLM phải gánh khoảng 34 call cùng lúc.",
      "window": [
        25.0,
        29.3103
      ]
    },
    {
      "element": ".cap-b5",
      "text": "Chỉ có nhãn, xác suất thì không đáng tin. Giao nhầm agent, code cũng không biết.",
      "window": [
        31.8966,
        36.2069
      ]
    },
    {
      "element": ".cap-b6",
      "text": "Thêm Jev: model chỉ chọn, không sinh text.",
      "window": [
        39.6552,
        43.1034
      ]
    },
    {
      "element": ".cap-b7",
      "text": "Một call, chấm 3 câu hỏi song song: khoảng 70–500 ms, có kèm xác suất.",
      "window": [
        45.6897,
        50.0
      ]
    },
    {
      "element": ".cap-b8",
      "text": "Code so xác suất với threshold: đủ cao thì giao thẳng cho agent đó.",
      "window": [
        52.5862,
        56.8966
      ]
    },
    {
      "element": ".cap-b9",
      "text": "Khách nhắn thêm lúc code đang quyết? State cũ thì dựng lại rồi mới giao.",
      "window": [
        59.4828,
        63.7931
      ]
    },
    {
      "element": ".cap-b10",
      "text": "Lưng chừng, hoặc Jev không trả lời kịp thì để triage LLM chọn agent.",
      "window": [
        66.3793,
        70.6897
      ]
    },
    {
      "element": ".cap-b11",
      "text": "Khiếu nại nặng, hoặc action rủi ro như refund thì luôn phải qua người duyệt.",
      "window": [
        73.2759,
        77.5862
      ]
    },
    {
      "element": ".cap-b12",
      "text": "Agent trả ticket về là một lần giao nhầm. Lấy log ra so, lệch thì siết threshold.",
      "window": [
        80.1724,
        84.4828
      ]
    },
    {
      "element": ".cap-b13",
      "text": "Việc của agent thì để agent làm. Chọn agent là Jev, luật giao việc ở code.",
      "window": [
        87.069,
        91.3793
      ]
    }
