    },
    {
      "element": ".cap-b1",
      "text": "Mục tiêu: tìm chuyến bay Zürich → London. Agent phải tự bấm trên trang, từng bước một.",
      "window": [
        4.6296,
        9.2593
      ]
    },
    {
      "element": ".cap-b2",
      "text": "Mỗi bước, code đọc cây DOM thành danh sách element có đánh số, kèm screenshot khi cần.",
      "window": [
        12.037,
        16.6667
      ]
    },
    {
      "element": ".cap-b3",
      "text": "LLM nhận cả trang làm prompt, rồi sinh JSON từng token: thinking, next_goal, action.",
      "window": [
        19.4444,
        24.0741
      ]
    },
    {
      "element": ".cap-b4",
      "text": "Action chỉ là text JSON: code phải parse, rồi tự kiểm tra xem element còn trên trang.",
      "window": [
        26.8519,
        31.4815
      ]
    },
    {
      "element": ".cap-b5",
      "text": "Bấm xong lại đọc trang, lặp N bước — bước nào cũng phải chờ LLM sinh chữ.",
      "window": [
        34.2593,
        38.8889
      ]
    },
    {
      "element": ".cap-b6",
      "text": "Với Jev: cùng trang, cùng mục tiêu, nhưng model chỉ chọn, không sinh text.",
      "window": [
        42.5926,
        46.2963
      ]
    },
    {
      "element": ".cap-b7",
      "text": "Một lần gọi browser đọc hết control đang hiện: tên, giá trị, text — không cần screenshot.",
      "window": [
        49.0741,
        53.7037
      ]
    },
    {
      "element": ".cap-b8",
      "text": "Jev trả lời hai câu hỏi trong một round trip: làm gì, với element nào — kèm xác suất.",
      "window": [
        56.4815,
        61.1111
      ]
    },
    {
      "element": ".cap-b9",
      "text": "Chỉ với TYPE_TEXT, một LLM nhỏ mới viết chữ cần gõ — và phải ra đúng JSON.",
      "window": [
        63.8889,
        68.5185
      ]
    },
    {
      "element": ".cap-b10",
      "text": "Trước khi gõ, code kiểm tra: trang còn mới, element còn hiện, không bị che.",
      "window": [
        71.2963,
        75.9259
      ]
    },
    {
      "element": ".cap-b11",
      "text": "Gõ Zurich, đợi gợi ý tối đa 200 ms, rồi đọc trang tiếp — cả task 7,1 giây.",
