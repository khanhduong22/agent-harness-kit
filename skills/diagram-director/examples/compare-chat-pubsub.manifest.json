  "captions": [
    {
      "element": ".cap-b1",
      "text": "One message must reach every room member on every server.",
      "window": [
        0.0,
        12.5
      ]
    },
    {
      "element": ".cap-b2",
      "text": "Without pub/sub, the origin server forwards a copy to each of the 19 peers itself.",
      "window": [
        16.0714,
        25.0
      ]
    },
    {
      "element": ".cap-b3",
      "text": "Every server links to every other: 190 standing connections at 20 servers.",
      "window": [
        30.3571,
        39.2857
      ]
    },
    {
      "element": ".cap-b4",
      "text": "ws-1 dies. Every copy it owed now re-routes through its peers.",
      "window": [
        44.6429,
        53.5714
      ]
    },
    {
      "element": ".cap-b5",
      "text": "ws-2 inherits the load and follows — the mesh dominoes.",
      "window": [
        58.9286,
        67.8571
      ]
    },
    {
      "element": ".cap-b6",
      "text": "The same server dies in B: clients reconnect; the stream never notices.",
      "window": [
        73.2143,
        82.1429
      ]
    },
    {
      "element": ".cap-b7",
      "text": "190 links become 20 subscriptions — and a dead server becomes a non-event.",
      "window": [
        87.5,
        97.1429
      ]
    }
