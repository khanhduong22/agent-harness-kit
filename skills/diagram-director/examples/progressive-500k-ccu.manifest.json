  "captions": [
    {
      "element": ".cap-b2",
      "text": "To 1K CCU a monolith and one Postgres hold — until the 100-connection pool queues.",
      "window": [
        9.4,
        16.2
      ]
    },
    {
      "element": ".cap-b3",
      "text": "Pool fixed by 6 replicas and a 90% cache; now the single Postgres caps at ~2K writes/s.",
      "window": [
        21.5,
        33.4
      ]
    },
    {
      "element": ".cap-b4",
      "text": "Reads move to CDN and 3 replicas, async work to a queue; one hot row still serializes writes.",
      "window": [
        38.7,
        50.6
      ]
    },
    {
      "element": ".cap-b5",
      "text": "16 shards spread the hot row; a pub/sub stream fans out; 3 cells cap the blast radius. 500K holds.",
      "window": [
        55.9,
        63.0
      ]
    },
    {
      "element": ".cap-b1",
      "text": "One system, four architectures: what broke decided every boundary.",
      "window": [
        69.6,
        75.6
      ]
    }
