  "captions": [
    {
      "element": ".cap-a1",
      "text": "One box takes every request; ten reads per write share one 100-connection pool.",
      "window": [
        7.0833,
        13.75
      ]
    },
    {
      "element": ".cap-a2",
      "text": "Six replicas and a 90% cache clear the pool; half the primary's work is reads.",
      "window": [
        17.0833,
        23.75
      ]
    },
    {
      "element": ".cap-a3a",
      "text": "Reads leave the primary: CDN first, then cache, then three read replicas.",
      "window": [
        27.5,
        34.1667
      ]
    },
    {
      "element": ".cap-a3b",
      "text": "Slow work leaves too — one queue, four workers, one job each.",
      "window": [
        35.0,
        40.4167
      ]
    },
    {
      "element": ".cap-a4a",
      "text": "One gateway routes to three services; each owns its own store.",
      "window": [
        44.1667,
        49.1667
      ]
    },
    {
      "element": ".cap-a4b",
      "text": "They publish instead of calling — but writes still hit one primary.",
      "window": [
        50.4167,
        55.4167
      ]
    },
    {
      "element": ".cap-a5a",
      "text": "hash(shard key) picks the owner: this write is 7c, so only shard 2 sees it.",
      "window": [
        59.1667,
        65.8333
      ]
    },
    {
      "element": ".cap-a5b",
      "text": "Three primaries, about 1K writes each per second; replicas still serve catalog reads.",
      "window": [
        67.5,
        73.75
      ]
    },
    {
      "element": ".cap-r",
      "text": "One system, five architectures — and one boundary was coupling, not load.",
      "window": [
        76.25,
        84.1667
      ]
    }
  ],
